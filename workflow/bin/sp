#!/usr/bin/env bash
# Main ShapePipe launch script for Snakemake workflow
#
# Usage:
#
#   sp run [-c FILE] [ARGS...]
#                      bring the products on disk up to date with the tile list.
#                      Snapshots the code into the state dir first (see "the
#                      launch code snapshot" below) and runs out of the copy, so
#                      editing the checkout mid-campaign cannot reach the jobs.
#                      Two Snakemake invocations: prepare_all_tiles, then all.
#                      See workflow/Snakefile for index construction between phases.
#                      ARGS (--jobs, -n, --forcerun, ...) pass through to both.
#                      FILE overrides workflow/config.yaml (read automatically).
#   sp report [ARGS...]  emit run_report.json (mid-run is fine).
#   sp container VERB    manage the image every job runs inside: pull, status,
#                      sandbox, exec, resolve. `sp container --help` documents
#                      the layers and the resolution order.
#
# Anything else is passed straight through to snakemake with the same profile and
# state dir (the escape hatch: `sp --unlock`, `sp exp_psf ...`, `sp --dag`).
#
# It ensures apptainer is on PATH and activates the Snakemake venv on shared
# /project storage: the executor re-invokes Snakemake inside compute jobs.
#
# Typical use, from the repo root:
#
#   SP_PROFILE=candide workflow/bin/sp run -c ~/my_run.yaml        # a campaign
#   SP_PROFILE=candide workflow/bin/sp run -c ~/my_run.yaml -n     # dry run
#   SP_PROFILE=candide workflow/bin/sp report -c ~/my_run.yaml     # status
#
# Run config: -c FILE, also --config-file. Read after workflow/config.yaml and
# merged on top; anything still unset comes from the machines: entry for
# SP_PROFILE and input_type, then the input_types: entry
# (workflow/scripts/run_config.py).
# To check a resolved value without running:
#
#   python workflow/scripts/run_config.py workflow/config.yaml ~/my_run.yaml outputs.run_dir
#
# -c is sp's flag, not snakemake's --cores; pass cores as --cores or -j.
#
# Environment:
#
#   SP_PROFILE        profiles/<name> to use (default nibi); also selects the
#                     machines: entry, and must match `machine:` if set
#   SP_SNAKEMAKE_ENV  venv to activate; skipped if snakemake is on PATH
#   SP_RUN_CONFIG     same as -c, and what the jobs read; -c wins
#   SP_STATE_DIR      snakemake state and code snapshot (default <run_dir>-state)
#   SP_CONTAINER      image to use, before the config's container:
#   SP_PHASE          set by sp (prepare/compute/passthrough); do not set
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"   # workflow/
REPO="$(dirname "$HERE")"
VENV="${SP_SNAKEMAKE_ENV:-/project/def-mjhudson/cdaley/snakemake-env}"
SCRIPTS="$HERE/scripts"
PROFILE="${SP_PROFILE:-nibi}"

# Consume -c as SP_RUN_CONFIG for shared config resolution and snapshotting.
# Stop at -- or container exec so delegated commands keep their own -c.
# Pass --config k=v through to Snakemake unchanged.
RUN_CONFIG="${SP_RUN_CONFIG:-}"
_sp_args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --)
      shift; _sp_args+=("$@"); break ;;
    -c|--config-file)
      [ $# -ge 2 ] || { echo "sp: $1 needs a file" >&2; exit 2; }
      RUN_CONFIG="$2"; shift 2 ;;
    -c=*|--config-file=*)
      RUN_CONFIG="${1#*=}"; shift ;;
    container)
      # container.py reads SP_RUN_CONFIG; exec arguments belong to its command.
      _sp_args+=("$1"); shift
      [ "${1:-}" = exec ] && { _sp_args+=("$@"); break; }
      ;;
    *) _sp_args+=("$1"); shift ;;
  esac
done
set -- ${_sp_args[@]+"${_sp_args[@]}"}

if [ -n "$RUN_CONFIG" ]; then
  [ -f "$RUN_CONFIG" ] || {
    echo "sp: run config $RUN_CONFIG does not exist" >&2; exit 2; }
  # Absolute: jobs and the snapshot run from other directories.
  RUN_CONFIG="$(cd "$(dirname "$RUN_CONFIG")" && pwd)/$(basename "$RUN_CONFIG")"
  export SP_RUN_CONFIG="$RUN_CONFIG"
fi

[ -d "$REPO/profiles/$PROFILE" ] || {
  echo "sp: no profile $REPO/profiles/$PROFILE (SP_PROFILE=$PROFILE)" >&2; exit 2; }

# Load a module only if apptainer is absent from PATH; candide supplies it in
# /usr/bin without a modulefile. Suppress both module output streams because
# environment-modules and Lmod report errors on different streams.
if ! command -v apptainer >/dev/null 2>&1; then
  module load apptainer/1.4.5 >/dev/null 2>&1 || true
  command -v apptainer >/dev/null 2>&1 || {
    echo "sp: apptainer is not on PATH and 'module load apptainer/1.4.5' failed" >&2
    exit 2; }
fi
if [ -f "$VENV/bin/activate" ]; then
  # shellcheck disable=SC1091
  source "$VENV/bin/activate"
elif ! command -v snakemake >/dev/null 2>&1; then
  echo "sp: no venv at $VENV and no snakemake on PATH (set SP_SNAKEMAKE_ENV)" >&2
  exit 2
fi

# Resolved config value (config.yaml + run config + machine defaults), as the
# Snakefile resolves it.
cfg() { python "$SCRIPTS/run_config.py" "$HERE/config.yaml" "${SP_RUN_CONFIG:-}" "$1"; }
RUN_DIR="$(cfg outputs.run_dir)"; INDEX_DB="$(cfg outputs.index_db)"
# Container, cancel and help need no campaign state. Check other commands
# before mkdir: an unset run leaves a literal $run in RUN_DIR.
case "${1:-}" in container|cancel|""|-h|--help) NEEDS_CAMPAIGN=0 ;; *) NEEDS_CAMPAIGN=1 ;; esac
if [ "$NEEDS_CAMPAIGN" = 1 ]; then
  if [ -z "$(cfg run)" ]; then
    echo "sp: \`run:\` is unset; the run config (-c FILE) names the campaign" >&2; exit 2
  fi
  if [ -z "$RUN_DIR" ] || [ "$RUN_DIR" = TBD ] || [[ "$RUN_DIR" == *'$'* ]]; then
    echo "sp: outputs.run_dir is unset, TBD or unexpanded ($RUN_DIR) for this machine/input_type" >&2; exit 2
  fi
fi

# Default state location: beside the run on /scratch, not the persistent root.
# DR6 produces >170k frequently rewritten metadata files; keeping that churn
# off backed-up /project avoids pressure on its ~1M-inode group quota.
# --directory moves state, not data: data paths are absolute, and the Snakefile
# resolves its own configfile.
STATE_DIR="${SP_STATE_DIR:-${RUN_DIR}-state}"
[ "$NEEDS_CAMPAIGN" = 0 ] || mkdir -p "$STATE_DIR"

# --- the launch code snapshot ----------------------------------------------
# SLURM jobs re-parse the Snakefile and read scripts/configs when they start,
# potentially hours after launch. sp run copies code to $STATE_DIR/code so
# checkout edits cannot give jobs in one campaign different implementations.
#
# @sc [label:custody] launch-snapshot-self-contained
# The snapshot includes workflow/, src/, scripts/ and profiles/. Dereference
# config symlinks into example/ so jobs need no live checkout. Workflow paths
# resolve from workflow.basedir, including the path-loaded final catalogue
# script; rewrite the profile's PYTHONPATH to the snapshot's src/. Copy the
# external run config too, so every job parse reads the launch configuration.
#
# @sc [label:hazard] launch-snapshot-refresh-boundary
# Every sp run refreshes the same snapshot path wholesale. Relaunch only after
# prior jobs using that state directory have stopped: queued or running jobs
# can otherwise read the refreshed code. Snakemake rerun triggers determine
# which finished products the relaunch invalidates (see workflow/CONTRACTS,
# unit-pre-changes-at-campaign-boundary). Other verbs reuse the existing copy,
# so sp --unlock reaches the workflow that took the lock.
SNAPSHOT="$STATE_DIR/code"
snapshot_code() {
  mkdir -p "$SNAPSHOT"
  if command -v rsync >/dev/null 2>&1; then
    rsync -a --delete --copy-links --exclude '__pycache__' --exclude '*.egg-info' \
      "$HERE" "$REPO/src" "$REPO/scripts" "$REPO/profiles" "$SNAPSHOT/"
  else
    rm -rf "$SNAPSHOT"; mkdir -p "$SNAPSHOT"
    cp -rL "$HERE" "$REPO/src" "$REPO/scripts" "$REPO/profiles" "$SNAPSHOT/"
    find "$SNAPSHOT" -name __pycache__ -type d -prune -exec rm -rf {} +
  fi

  # Rewrite only PYTHONPATH in the generated profile; the checked-in profile
  # owns the flags. Variable expansion limits are documented in profiles/nibi.
  python - "$SNAPSHOT/profiles/$PROFILE/config.yaml" "$SNAPSHOT/src" <<'PY'
import pathlib, re, sys
f, src = pathlib.Path(sys.argv[1]), sys.argv[2]
text, n = re.subn(r'(--env PYTHONPATH=)\S+', lambda m: m.group(1) + src,
                  f.read_text(), count=1)
if not n:
    sys.exit("sp: no --env PYTHONPATH= found in the profile's apptainer-args; "
             "the snapshot would run against the live checkout's src/")
f.write_text(text)
PY

  # Move the tile store by rewriting the bind source, not tile_local()'s params:
  # params changes invalidate finished tiles (workflow/CONTRACTS). This bind is
  # not a rerun trigger. Append it if the profile has no X:/local/scratch bind.
  # See workflow/config.yaml for tile_store_root's capacity/latency trade-off.
  python - "$SNAPSHOT/profiles/$PROFILE/config.yaml" "$(cfg tile_store_root)" <<'PY'
import os, pathlib, re, sys
f, root = pathlib.Path(sys.argv[1]), sys.argv[2]
if root:
    root = str(root)
    if not os.path.isabs(root):
        sys.exit(f"sp: tile_store_root must be an absolute path, got {root!r}")
    os.makedirs(root, exist_ok=True)
    bind = f"--bind {root}:/local/scratch"
    text, n = re.subn(r'--bind \S+:/local/scratch(?=[\s"])', lambda m: bind,
                      f.read_text(), count=1)
    if not n:
        text, n = re.subn(r'(apptainer-args:\s*"[^"]*)"',
                          lambda m: m.group(1) + " " + bind + '"', text, count=1)
    if not n:
        sys.exit("sp: tile_store_root is set but the profile has no quoted "
                 "apptainer-args to bind it with")
    f.write_text(text)
    print(f"sp: tile store root {root} (bound to /local/scratch)", file=sys.stderr)
PY

  python - "$SNAPSHOT/snapshot.json" "$REPO" <<'PY'
import json, pathlib, subprocess, sys, time
out, repo = pathlib.Path(sys.argv[1]), sys.argv[2]
def git(*a):
    try:
        p = subprocess.run(["git", "-C", repo, *a], capture_output=True,
                           text=True, timeout=30)
    except OSError:
        return None
    return p.stdout.strip() if p.returncode == 0 else None
status = git("status", "--porcelain")
out.write_text(json.dumps({
    "_comment": "Code snapshot taken by `sp run`; the campaign runs out of THIS "
                "tree, never the checkout. Refreshed wholesale on every `sp run`.",
    "source": repo,
    "taken_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
    "head": git("rev-parse", "HEAD"),
    "branch": git("rev-parse", "--abbrev-ref", "HEAD"),
    "dirty": bool(status),
    "dirty_files": status.splitlines() if status else [],
}, indent=2) + "\n")
PY
  # An external run config is part of what is launched: snapshot it with the
  # code, so a job re-parsing hours later reads the config the run started with.
  if [ -n "${SP_RUN_CONFIG:-}" ]; then
    cp "$SP_RUN_CONFIG" "$SNAPSHOT/run_config.yaml"
  fi
  echo "sp: code snapshot refreshed at $SNAPSHOT" >&2
}

# SP_MISSING_THRESHOLD gates the compute parse's index build: the fraction of
# declared tiles allowed to be missing their exposure list (default 0.0).
export SP_MISSING_THRESHOLD="${SP_MISSING_THRESHOLD:-0.0}"

# Use the campaign snapshot when present; otherwise use the checkout.
# Container tooling bypasses this helper because it is not campaign-specific.
code_root() { [ -f "$SNAPSHOT/workflow/Snakefile" ] && echo "$SNAPSHOT" || echo "$REPO"; }

# Absolute --snakefile works from any cwd and pins executor job parses to the
# same tree. Set the phase required by the Snakefile: run uses prepare/compute;
# other commands default to passthrough (see the Snakefile's SP_PHASE gate).
sm() {
  local root; root="$(code_root)"
  # The run config the Snakefile reads: the snapshot's copy when this run has
  # one, so every parse of the campaign -- head and jobs -- sees the same file.
  if [ -n "${SP_RUN_CONFIG:-}" ] && [ -f "$root/run_config.yaml" ]; then
    export SP_RUN_CONFIG="$root/run_config.yaml"
  fi
  SP_PHASE="${SP_PHASE:-passthrough}" \
    snakemake --snakefile "$root/workflow/Snakefile" \
              --profile "$root/profiles/$PROFILE" \
              --directory "$STATE_DIR" "$@"
}

cmd="${1:-}"
case "$cmd" in
  run)
    shift
    snapshot_code
    # Continue after prepare failure so compute can apply SP_MISSING_THRESHOLD
    # to the whole tile list. Retain prepare's failure for the final exit code.
    prep_rc=0
    SP_PHASE=prepare sm prepare_all_tiles "$@" || prep_rc=$?
    if [ "$prep_rc" -ne 0 ]; then
      echo "" >&2
      echo "############################################################" >&2
      echo "## WARNING: the PREPARE phase exited $prep_rc." >&2
      echo "## Some tiles may be missing their exposure list and will be" >&2
      echo "## dropped from the compute DAG. Continuing to COMPUTE; the" >&2
      echo "## SP_MISSING_THRESHOLD gate (now $SP_MISSING_THRESHOLD) decides" >&2
      echo "## whether that is tolerable." >&2
      echo "############################################################" >&2
      echo "" >&2
    fi

    comp_rc=0
    SP_PHASE=compute sm all "$@" || comp_rc=$?
    if [ "$prep_rc" -ne 0 ] || [ "$comp_rc" -ne 0 ]; then
      exit "$([ "$comp_rc" -ne 0 ] && echo "$comp_rc" || echo "$prep_rc")"
    fi
    ;;
  report)
    # Use the same snapshot script as the campaign's automatic report hooks.
    shift
    SP_TILE_DETECTION="$(cfg tile_detection)" \
    python "$(code_root)/workflow/scripts/run_report.py" \
      --run-dir "$RUN_DIR" --index "$INDEX_DB" \
      --status manual "$@"
    ;;
  container)
    # Run host-side container tooling from the checkout: status compares against
    # HEAD, and exec uses the checked-in profile rather than a campaign snapshot.
    shift
    python "$SCRIPTS/container.py" "$@"
    ;;
  cancel)
    # Cancel the user's jobs whose names match the supplied regular expression.
    run="${2:?usage: sp cancel <run-name-substring>}"
    squeue --me --noheader --format='%i %j' \
      | awk -v r="$run" '$2 ~ r {print $1}' | xargs -r scancel
    echo "cancelled jobs matching '$run'; safe to --unlock / rerun now"
    ;;
  ""|-h|--help)
    # snakemake's own usage: parsing the Snakefile would need a campaign.
    snakemake --help
    ;;
  *)
    sm "$@"
    ;;
esac

## SETools configuration file for star/galaxy separation based on size/mag properties
##
## The mask cut is IMAFLAGS_ISO == 0: instrument flags identify corrupted
## pixels, while sky-fixed external masks identify locations rather than
## unusable measurements. PSF outlier rejection handles location-dependent
## contamination without an external-mask veto.
##
## To veto external masks, enable the desired maps in mask_query's MASK_PATHS
## and add MASK_EXT == 0 beside each IMAFLAGS_ISO line below. MASK_PATHS ships
## commented out, so mask_query is a pass-through and writes no MASK_EXT.
## SETools has no bitwise operators; select mask bits in MASK_PATHS.

# @sc [decision:masking.psf_star_mask_veto,decision:star_selection_psf.star_selection_box]
[MASK:preselect]

MAG_AUTO > 0
MAG_AUTO < 21
# FWHM_WORLD is in degrees, from each CCD's WCS: 0.3-1.5 arcsec.
FWHM_WORLD > 0.3 / 3600
FWHM_WORLD < 1.5 / 3600
# @sc [decision:detection.saturation_level]
FLAGS == 0

IMAFLAGS_ISO == 0
NO_SAVE

# @sc [decision:masking.psf_star_mask_veto]
[MASK:flag]

# @sc [decision:detection.saturation_level]
FLAGS == 0

IMAFLAGS_ISO == 0
NO_SAVE


# @sc [decision:masking.psf_star_mask_veto,decision:star_selection_psf.star_selection_box]
[MASK:star_selection]
# Star selection: FWHM within 3 locus widths of the stellar-locus peak

MAG_AUTO > 18.
MAG_AUTO < 22.
FWHM_IMAGE <= mode(FWHM_IMAGE{preselect}) + 3 * locus_width(FWHM_IMAGE{preselect})
FWHM_IMAGE >= mode(FWHM_IMAGE{preselect}) - 3 * locus_width(FWHM_IMAGE{preselect})
# @sc [decision:detection.saturation_level]
FLAGS == 0
# @sc [decision:masking.pixel_mask_source]
IMAFLAGS_ISO == 0

[MASK:fwhm_mag_cut]
FWHM_IMAGE > 0
FWHM_IMAGE < 40
MAG_AUTO < 35
FLAGS == 0
IMAFLAGS_ISO == 0
NO_SAVE

# Split the 'star_selection' sample into
# two random sub-samples with ratio 80/20
[RAND_SPLIT:star_split]
# @sc [decision:star_selection_psf.psf_train_validation_split]
RATIO = 20

MASK = star_selection

# The following selection is only used for plotting

[PLOT:size_mag]
TYPE = plot
FORMAT = png
X_1 = FWHM_IMAGE{fwhm_mag_cut}
Y_1 = MAG_AUTO{fwhm_mag_cut}
X_2 = FWHM_IMAGE{star_selection}
Y_2 = MAG_AUTO{star_selection}
MARKER_1 = +
MARKER_2 = .
MARKERSIZE_1 = 3
MARKERSIZE_2 = 3
LABEL_1 = All
LABEL_2 = "Stars, mean FWHM: @mean(FWHM_WORLD{star_selection})*3600@ arcsec"
TITLE = "Stellar locus"
XLABEL = "FWHM (pix)"
YLABEL = Mag

[PLOT:hist_mag_stars]
TYPE = hist
FORMAT = png
Y = MAG_AUTO{star_selection}
BIN = 20
LABEL = "stars"
XLABEL = "Magnitude"
YLABEL = "Number"
TITLE = "Magnitude of stars"

[PLOT:fwhm_field]
TYPE = scatter
FORMAT = png
X = X_IMAGE{star_selection}
Y = Y_IMAGE{star_selection}
# @sc [decision:star_selection_psf.star_selection_box,label:diagnostic] stellar-diagnostic-matches-cut
# FWHM_FIELD plot labels and summary statistics must describe the size cut actually applied.
SCATTER = FWHM_WORLD{star_selection}*3600

MARKER = .
LABEL = "FWHM (arcsec)"
TITLE = "FWHM of stars"
XLABEL = "X (pix)"
YLABEL = "Y (pix)"

[PLOT:mag_star_field]
TYPE = scatter
FORMAT = png
X = X_IMAGE{star_selection}
Y = Y_IMAGE{star_selection}
SCATTER = MAG_AUTO{star_selection}
MARKER = .
LABEL = "Magnitude"
TITLE = "Magnitude of stars"
XLABEL = "X (pix)"
YLABEL = "Y (pix)"

[STAT:star_stat]
"Nb objects full cat" = len(FWHM_IMAGE)
"Nb objects not masked" = len(FWHM_IMAGE{flag})
"Nb stars" = len(FWHM_IMAGE{star_selection})
"Mean star fwhm selected (arcsec)" = mean(FWHM_WORLD{star_selection})*3600
"Standard deviation fwhm star selected (arcsec)" = std(FWHM_WORLD{star_selection})*3600
"Mode fwhm used (pix)" = mode(FWHM_IMAGE{preselect})
"Locus width (pix)" = locus_width(FWHM_IMAGE{preselect})
"Min fwhm cut (pix)" = mode(FWHM_IMAGE{preselect})-3*locus_width(FWHM_IMAGE{preselect})
"Max fwhm cut (pix)" = mode(FWHM_IMAGE{preselect})+3*locus_width(FWHM_IMAGE{preselect})

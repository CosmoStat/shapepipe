# Basic configuration

## Type: data or image_sims
type: image_sims

## Base run directory (-d flag)
base: /n17data/mkilbing/astro/Runs/shapepipe/CFIS/v2.0/image_sims/grids

## Tile IDs path (-T flag)
tile_IDs: "/home/mkilbing/shapepipe/auxdir/CFIS/im_sims_202606/tile_numbers_{num}.txt"

## Config directory for ShapePipe (-C flag); if omitted, type-specific default is used
config_dir: /home/mkilbing/shapepipe/example/cfis_image_sims

## Optional: exclusive list of tiles to process (for testing)
## If provided, only these tiles will be used instead of all tiles from tile_IDs
## Leave empty/commented out to use all tiles from tile_IDs
# tile_IDs_exclusive: ["251.288", "251.289", "252.287"]

## Optional: tiles to remove from the list (e.g. blank/corrupt input images)
## Low-coverage tiles are excluded automatically via "snakemake coverage";
## use this for manual exclusions on top of that
# tile_IDs_exclude: ["281.281"]

## Minimum input-tile coverage (nonzero weight fraction); tiles below are
## excluded after running "snakemake coverage" (writes tile_coverage_grid_{num}.yaml)
min_tile_coverage: 0.5

## Input simulation base dir (-i flag)
input_sims_base_dir: /n09data/hervas/skills_out/

## Input tiles and exposures directories (supports {subdir} and {input_sims_base_dir} placeholders)
input_tiles: "{input_sims_base_dir}/{subdir}/images/SP_tiles"
input_exp: "{input_sims_base_dir}/{subdir}/images/SP_exp"

## Galaxy sample (-S flag) (for cuts and selection); catalogue subversion
sample:  9

## parameter file for extraction (-P flag)
params_py: /home/mkilbing/sp_validation/notebooks/params.py

## SMP batch size per ShapePipe job (-1 = use config file default = 1)
n_smp:   -1

## Simulation type
sims_type:    grid

## Grid number
num:     2


## Calibration

## Input shear amplitude
shear_amplitude: 0.025

## Position matching (for grids)
match_radius_deg: 0.0002

## Pair-match objects between sheared catalogues; if false, use all objects
pair_match: true

## Weight schemes for m-bias; "none" = uniform weights; first entry is primary
w_cols: ['none', 'w_iv']

## Bootstrap error estimation
n_bootstrap: 500

"""Snakemake workflow for image-simulation pipeline.

Run from the run directory:
    snakemake -s Snakefile --configfile config.yaml -j 1 -- coverage   # once per grid, runs init if needed
    snakemake -s Snakefile --configfile config.yaml -j 4 --rerun-triggers=mtime -- pipeline_all
    snakemake -s Snakefile --configfile config.yaml -j 1 --dry-run -- pipeline_all

ShapePipe stages run in one-shot mode by default: one job per (sim, tile)
covering the whole bit sequence (-j 4095); n_sims x n_tiles independent
jobs. Use --config per_bit=1 (implied by job=N) for per-bit jobs.

Cluster execution (SLURM, snakemake >= 8 with snakemake-executor-plugin-slurm):
run from a login-node tmux; each job becomes its own sbatch submission:
    snakemake -s Snakefile --configfile config.yaml --executor slurm -j 128 \
        --default-resources slurm_partition=<partition> cpus_per_task=12 \
        mem_mb=8000 runtime=6h --rerun-triggers=mtime -- pipeline_all
Always give runtime WITH a unit (6h, 2d): a bare number on the command line
is parsed as SECONDS by snakemake's human-friendly resource parser.
Keep cpus_per_task >= 12: it caps jobs per node; the per-user process limit
(ulimit -u 1200, per node) crashes apptainer beyond ~4 jobs per 48-core node.
Verify after submitting: squeue -o "%C %l" must show 12 and 6:00:00.

When running locally, use a small fixed -j (e.g. 4), not -j
$OMP_NUM_THREADS: each job spawns MPI processes, and ulimit -u on candide
is 1200 ("can't start new thread" crash).

--rerun-triggers=mtime avoids re-running completed jobs after edits to this
file or to config.yaml (default triggers include rule-code changes).
"""

import os

# ---------- configuration ----------
configfile: "config.yaml"

BASE         = config["base"]
SAMPLE       = str(config["sample"])
NUM          = config["num"]
TYPE         = config["sims_type"]

# Load tile IDs from file (always a file path)
# If tile_IDs not specified, construct path with num-specific file
if "tile_IDs" in config:
    _tile_ids_file = config["tile_IDs"].replace("{num}", str(NUM))
else:
    # Try num-specific tile file first
    _tile_ids_file = f"{os.path.expanduser('~')}/shapepipe/auxdir/CFIS/im_sims_202606/tile_numbers_{NUM}.txt"
    if not os.path.exists(_tile_ids_file):
        # Fall back to default
        _tile_ids_file = f"{os.path.expanduser('~')}/shapepipe/auxdir/CFIS/im_sims_202606/tile_numbers.txt"

with open(_tile_ids_file) as f:
    TILE_IDs = [line.strip() for line in f if line.strip()]

# Apply exclusive tile list if provided (for testing/limiting tiles)
_exclusive = config.get("tile_IDs_exclusive")
if _exclusive and isinstance(_exclusive, list) and _exclusive:  # Non-empty list
    TILE_IDs = _exclusive

# Remove excluded tiles if provided (e.g. blank input images)
_exclude = config.get("tile_IDs_exclude")
if _exclude and isinstance(_exclude, list):
    _exclude_set = set(str(t) for t in _exclude)
    TILE_IDs = [t for t in TILE_IDs if t not in _exclude_set]

# Remove low-coverage tiles found by check_tile_coverage.py, if the scan
# has been run ("snakemake coverage"). Read at DAG-build time and kept out
# of rule inputs so a rescan does not invalidate completed jobs.
COVERAGE_FILE = f"{BASE}/tile_coverage_grid_{config['num']}.yaml"
if os.path.isfile(COVERAGE_FILE):
    import yaml as _yaml
    with open(COVERAGE_FILE) as _f:
        _cov_exclude = set(str(t) for t in _yaml.safe_load(_f).get("exclude", []))
    _n_before = len(TILE_IDs)
    TILE_IDs = [t for t in TILE_IDs if t not in _cov_exclude]
    if len(TILE_IDs) < _n_before:
        print(
            f"Coverage scan: excluding {_n_before - len(TILE_IDs)} "
            f"low-coverage tiles ({len(TILE_IDs)} remain), see {COVERAGE_FILE}"
        )
else:
    print(
        f"No coverage scan found ({COVERAGE_FILE}); "
        f"run 'snakemake coverage' first to exclude (near-)empty input tiles"
    )
FORCE        = "--force" if config.get("force", 0) else ""
N_SMP        = config.get("n_smp", -1)
SHEAR_AMP    = config.get("shear_amplitude", 0.02)
MATCH_RAD    = config.get("match_radius_deg", 0.0002)
PAIR_MATCH   = "true" if config.get("pair_match", True) else "false"
# Weight schemes for m-bias; "none" means uniform weights, first is primary
_w_cols      = config.get("w_cols") or (
    [config["w_col"]] if config.get("w_col") else ["none", "w_iv"]
)
W_COLS       = "[" + ", ".join(f"'{w}'" for w in _w_cols) + "]"
N_BOOT       = config.get("n_bootstrap", 500)

FULL_JOB_SEQUENCE = [1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048]
# Filter by bitmask if specified via --config "job=N" (N may combine multiple bits)
if config.get("job"):
    target_job = int(config["job"])
    JOB_SEQUENCE = [j for j in FULL_JOB_SEQUENCE if j & target_job]
else:
    JOB_SEQUENCE = list(FULL_JOB_SEQUENCE)
JOB          = sum(JOB_SEQUENCE)

PSF          = "psfex"

STR_TYPE = f"_{TYPE}" if TYPE == "grid" else ""
SIMS = [
    f"1{dg1}2{dg2}{STR_TYPE}_{NUM}"
    for dg1, dg2 in zip(["m", "p", "z", "z"],
                         ["z", "z", "m", "p"])
]

HOME       = os.path.expanduser("~")
PATH_SH    = f"{HOME}/astro/repositories/github/shapepipe/scripts/sh"
PATH_PY    = f"{HOME}/astro/repositories/github/shapepipe/scripts/python"
PATH_IMSIM = f"{HOME}/astro/repositories/github/shapepipe/scripts/image_sims_pipeline"
PATH_NB  = f"{HOME}/astro/repositories/github/sp_validation/notebooks"
PATH_SPV = f"{HOME}/astro/repositories/github/sp_validation"

SPV_SIF     = "/n17data/mkilbing/sp_validation_im_sims.sif"
# The same container holds shapepipe and sp_validation code
SP_SIF = SPV_SIF
SPV_SRC     = f"{HOME}/astro/repositories/github/sp_validation/src"
SP_SRC      = f"{HOME}/astro/repositories/github/shapepipe/src"

# Cap threading libraries inside containers; the host OMP_NUM_THREADS would
# otherwise leak in and N parallel jobs x N threads exhausts ulimit -u
_THREAD_CAPS = (
    "OMP_NUM_THREADS=1,OPENBLAS_NUM_THREADS=1,"
    "MKL_NUM_THREADS=1,NUMEXPR_NUM_THREADS=1"
)

# ShapePipe pipeline stages (uses shapepipe_im_sims.sif — correct MPI build)
_APPTAINER  = f"{PATH_SH}/apptainer_noslurm.sh"
APP_CMD     = (
    f"{_APPTAINER} --bind /n17data,/n09data,/home"
    f" --env PYTHONPATH={SP_SRC}"
    f" --env PYTHONWARNINGS=ignore::SyntaxWarning"
    f" --env {_THREAD_CAPS}"
    f" {SP_SIF}"
)

# sp_validation stages (uses sp_validation_im_sims.sif with local src override)
SPV_CMD     = (
    f"{_APPTAINER} --bind /n17data,/n09data,/home"
    f" --env PYTHONPATH={SPV_SRC}"
    f" --env {_THREAD_CAPS}"
    f" {SPV_SIF}"
)
MBIAS_OUT   = f"{BASE}/results/m_bias_results.yaml"

# ---------- helper functions ----------
def validate_output_files(output_files):
    """Validate that output files exist and are non-empty.

    Raises an error if any output file is missing or zero-sized,
    preventing empty/corrupt files from being treated as valid outputs.
    """
    if isinstance(output_files, str):
        output_files = [output_files]

    for f in output_files:
        if not os.path.isfile(f):
            raise FileNotFoundError(f"Output file missing: {f}")
        size = os.path.getsize(f)
        if size == 0:
            raise ValueError(f"Output file is empty (0 bytes): {f}")

# ---------- targets ----------
rule all:
    input:
        expand(f"{BASE}/{{sim}}/shape_catalog_cut_ngmix.fits", sim=SIMS)

# Individual job bit targets (run without config filtering)
rule job_1_only:
    input:
        expand(f"{BASE}/{{sim}}/logs/log_job_{{tile}}_1.txt", sim=SIMS, tile=TILE_IDs)

rule job_2_only:
    input:
        expand(f"{BASE}/{{sim}}/logs/log_job_{{tile}}_2.txt", sim=SIMS, tile=TILE_IDs)

rule job_4_only:
    input:
        expand(f"{BASE}/{{sim}}/logs/log_job_{{tile}}_4.txt", sim=SIMS, tile=TILE_IDs)

rule job_8_only:
    input:
        expand(f"{BASE}/{{sim}}/logs/log_job_{{tile}}_8.txt", sim=SIMS, tile=TILE_IDs)

rule job_16_only:
    input:
        expand(f"{BASE}/{{sim}}/logs/log_job_{{tile}}_16.txt", sim=SIMS, tile=TILE_IDs)

rule job_32_only:
    input:
        expand(f"{BASE}/{{sim}}/logs/log_job_{{tile}}_32.txt", sim=SIMS, tile=TILE_IDs)

rule job_64_only:
    input:
        expand(f"{BASE}/{{sim}}/logs/log_job_{{tile}}_64.txt", sim=SIMS, tile=TILE_IDs)

rule job_128_only:
    input:
        expand(f"{BASE}/{{sim}}/logs/log_job_{{tile}}_128.txt", sim=SIMS, tile=TILE_IDs)

rule job_256_only:
    input:
        expand(f"{BASE}/{{sim}}/logs/log_job_{{tile}}_256.txt", sim=SIMS, tile=TILE_IDs)

rule job_512_only:
    input:
        expand(f"{BASE}/{{sim}}/logs/log_job_{{tile}}_512.txt", sim=SIMS, tile=TILE_IDs)

rule job_1024_only:
    input:
        expand(f"{BASE}/{{sim}}/logs/log_job_{{tile}}_1024.txt", sim=SIMS, tile=TILE_IDs)

rule job_2048_only:
    input:
        expand(f"{BASE}/{{sim}}/logs/log_job_{{tile}}_2048.txt", sim=SIMS, tile=TILE_IDs)

# ---------- convenience targets (run in order) ----------
# 1. init_all
# 2. pipeline_all
# 3. merge_all
# 4. extract_all
# 5. calibrate_all
# 6. mbias
# 7. diagnostics

# Pixel thinning for the coverage scan: read every Nth pixel per axis
COVERAGE_SUBSAMPLE = 20
# Weight-map location is read from this variant's get-images ini (from init)
SIM_REF = f"1p2z{STR_TYPE}_{NUM}"

rule coverage:
    """Scan input weight maps; write low-coverage tile exclude list.

    Run this once per grid, after init_all and BEFORE pipeline_all: the
    exclude list is read at DAG-build time, so it only takes effect on
    the next invocation. Rerun with -f after the input sims change
    (e.g. tile regeneration).
    """
    input:
        f"{BASE}/{SIM_REF}/params.py"
    output:
        COVERAGE_FILE
    shell:
        f"{SPV_CMD} python {PATH_IMSIM}/check_tile_coverage.py"
        f" -c {BASE}/config.yaml -o {{output}}"
        f" --subsample {COVERAGE_SUBSAMPLE} -v"

rule generate_tile_list:
    """Generate tile_numbers.txt from config's tile_IDs."""
    output:
        f"{BASE}/tile_numbers.txt"
    run:
        os.makedirs(f"{BASE}", exist_ok=True)
        with open(output[0], "w") as f:
            for tile in TILE_IDs:
                f.write(f"{tile}\n")
        print(f"Generated {output[0]} with {len(TILE_IDs)} tiles")

rule init_all:
    input:
        expand(f"{BASE}/{{sim}}/params.py", sim=SIMS)

rule pipeline_all:
    input:
        expand(
            f"{BASE}/{{sim}}/logs/log_job_{{tile}}_{JOB_SEQUENCE[-1]}.txt",
            sim=SIMS, tile=TILE_IDs
        )

rule merge_all:
    input:
        expand(f"{BASE}/{{sim}}/final_cat_{{sim}}.hdf5", sim=SIMS)

rule extract_all:
    input:
        expand(f"{BASE}/{{sim}}/shape_catalog_comprehensive_ngmix.hdf5", sim=SIMS)

rule calibrate_all:
    input:
        expand(f"{BASE}/{{sim}}/shape_catalog_cut_ngmix.fits", sim=SIMS)

# ---------- rules ----------
# config.yaml is deliberately not a tracked input: editing it (e.g. to
# exclude tiles) must not invalidate init and cascade into a full re-run.
# After config changes that require re-init, run: snakemake -f init_all
rule init:
    output:
        params = f"{BASE}/{{sim}}/params.py",
        mask   = f"{BASE}/{{sim}}/config_mask.yaml",
        tiles  = f"{BASE}/{{sim}}/tile_numbers.txt",
        cfis   = directory(f"{BASE}/{{sim}}/cfis"),
    shell:
        f"python3 {PATH_PY}/init_run_v2.0.py"
        f" -c {BASE}/config.yaml -s {{wildcards.sim}} -q"

# Two execution modes for the ShapePipe stages:
# - one-shot (default): one job per (sim, tile) running the whole (filtered)
#   bit sequence via a single -j {JOB} call. Ideal for cluster execution:
#   n_sims x n_tiles independent jobs. Resume-safe: the run script skips
#   bits whose existing run is complete.
# - per-bit (--config per_bit=1, or implied by --config job=N): one job per
#   (sim, tile, bit) with inter-bit dependencies; for surgical reruns.
PER_BIT = bool(config.get("job")) or bool(config.get("per_bit", 0))

if PER_BIT:
    def _shapepipe_job_input(wildcards):
        bit     = int(wildcards.bit)
        tile    = wildcards.tile
        bit_idx = JOB_SEQUENCE.index(bit)

        if bit_idx > 0:
            # Previous bit in the filtered sequence
            return f"{BASE}/{wildcards.sim}/logs/log_job_{tile}_{JOB_SEQUENCE[bit_idx - 1]}.txt"

        # First bit in the filtered sequence: find predecessor in the full sequence
        full_idx = FULL_JOB_SEQUENCE.index(bit)
        if full_idx == 0:
            return [
                f"{BASE}/{wildcards.sim}/params.py",
                f"{BASE}/{wildcards.sim}/config_mask.yaml",
            ]
        return f"{BASE}/{wildcards.sim}/logs/log_job_{tile}_{FULL_JOB_SEQUENCE[full_idx - 1]}.txt"

    rule shapepipe_job:
        input:  _shapepipe_job_input
        output: f"{BASE}/{{sim}}/logs/log_job_{{tile}}_{{bit}}.txt"
        # log file keeps stdout/stderr; unlike output, it survives job failure
        log:    f"{BASE}/{{sim}}/logs/err_job_{{tile}}_{{bit}}.txt"
        wildcard_constraints:
            bit  = "|".join(str(b) for b in JOB_SEQUENCE),
            tile = "|".join(t.replace(".", r"\.") for t in TILE_IDs),
        shell:
            f"( cd {BASE}/{{wildcards.sim}} &&"
            f" {APP_CMD} {PATH_SH}/run_job_sp_canfar_v2.0.bash"
            f" {FORCE} -N {N_SMP} -e {{wildcards.tile}} -t image_sims -j {{wildcards.bit}} &&"
            f" python3 -c \"import os; f='{{output}}'; "
            f"os.path.getsize(f) > 0 or exit(1)\""
            f" ) 2>&1 | tee {{log}}"
else:
    rule shapepipe_tile:
        input:
            f"{BASE}/{{sim}}/params.py",
            f"{BASE}/{{sim}}/config_mask.yaml",
        # Last bit's log marks the whole chain done; per-bit logs are still
        # written along the way (info.py monitoring keeps working)
        output:
            f"{BASE}/{{sim}}/logs/log_job_{{tile}}_{JOB_SEQUENCE[-1]}.txt"
        log:
            f"{BASE}/{{sim}}/logs/err_job_{{tile}}_all.txt"
        wildcard_constraints:
            tile = "|".join(t.replace(".", r"\.") for t in TILE_IDs),
        shell:
            f"( cd {BASE}/{{wildcards.sim}} &&"
            f" {APP_CMD} {PATH_SH}/run_job_sp_canfar_v2.0.bash"
            f" {FORCE} -N {N_SMP} -e {{wildcards.tile}} -t image_sims -j {JOB} &&"
            f" python3 -c \"import os; f='{{output}}'; "
            f"os.path.getsize(f) > 0 or exit(1)\""
            f" ) 2>&1 | tee {{log}}"

rule merge:
    input:
        expand(
            f"{BASE}/{{{{sim}}}}/logs/log_job_{{tile}}_{JOB_SEQUENCE[-1]}.txt",
            tile=TILE_IDs
        )
    output:
        f"{BASE}/{{sim}}/final_cat_{{sim}}.hdf5"
    shell:
        f"cd {BASE}/{{wildcards.sim}} &&"
        f" {SPV_CMD} python {PATH_PY}/create_final_cat.py"
        f" -I -m final_cat_{{wildcards.sim}}.hdf5"
        f" -i .. -p cfis/final_cat.param -P {{wildcards.sim}}"
        f" -o n_tiles_final.txt -v"

rule extract:
    input:
        cat    = f"{BASE}/{{sim}}/final_cat_{{sim}}.hdf5",
        params = f"{BASE}/{{sim}}/params.py",
    output:
        f"{BASE}/{{sim}}/shape_catalog_comprehensive_ngmix.hdf5"
    shell:
        f"cd {BASE}/{{wildcards.sim}} &&"
        f" {SPV_CMD} python {PATH_NB}/extract_info.py"

rule calibrate:
    input:
        cat  = f"{BASE}/{{sim}}/shape_catalog_comprehensive_ngmix.hdf5",
        mask = f"{BASE}/{{sim}}/config_mask.yaml",
    output:
        f"{BASE}/{{sim}}/shape_catalog_cut_ngmix.fits"
    shell:
        f"cd {BASE}/{{wildcards.sim}} &&"
        f" {SPV_CMD} python {PATH_SPV}/notebooks/calibrate_comprehensive_cat.py -s calibrate"

rule mbias:
    input:
        expand(f"{BASE}/{{sim}}/shape_catalog_cut_ngmix.fits", sim=SIMS)
    # mbias_cumulative.yaml is deliberately not declared as an output:
    # it accumulates results across runs, and Snakemake deletes declared
    # outputs before rerunning a rule
    output:
        MBIAS_OUT,
    shell:
        f"mkdir -p {BASE}/results && cat > /tmp/mbias_cfg.yaml << 'EOF'\n"
        f"base: {BASE}\n"
        f"num: {NUM}\n"
        f"catalog_name: shape_catalog_cut_ngmix.fits\n"
        f"shear_amplitude: {SHEAR_AMP}\n"
        f"match_radius_deg: {MATCH_RAD}\n"
        f"pair_match: {PAIR_MATCH}\n"
        f"w_cols: {W_COLS}\n"
        f"n_bootstrap: {N_BOOT}\n"
        f"output_path: {BASE}/results/m_bias_results.yaml\n"
        f"results_dir: {BASE}/results\n"
        f"EOF\n"
        f"{SPV_CMD} python {PATH_SPV}/scripts/compute_m_bias_image_sims.py"
        f" -c /tmp/mbias_cfg.yaml -v --cumulative"

rule diagnostics:
    input:
        expand(f"{BASE}/{{sim}}/shape_catalog_cut_ngmix.fits", sim=SIMS)
    output:
        f"{BASE}/results/footprint.png",
    shell:
        f"mkdir -p {BASE}/results && cat > /tmp/diag_cfg.yaml << 'EOF'\n"
        f"base: {BASE}\n"
        f"num: {NUM}\n"
        f"catalog_name: shape_catalog_cut_ngmix.fits\n"
        f"shear_amplitude: {SHEAR_AMP}\n"
        f"match_radius_deg: {MATCH_RAD}\n"
        f"pair_match: {PAIR_MATCH}\n"
        f"w_cols: {W_COLS}\n"
        f"n_bootstrap: {N_BOOT}\n"
        f"output_path: {BASE}/results/m_bias_results.yaml\n"
        f"results_dir: {BASE}/results\n"
        f"diagnostics_dir: {BASE}/results\n"
        f"EOF\n"
        f"{SPV_CMD} python {PATH_SPV}/scripts/diagnostics_image_sims.py"
        f" -c /tmp/diag_cfg.yaml -v"
